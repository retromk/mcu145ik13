# Tang Nano 9K constraints template for mk61_top.
# Update pin numbers to your exact board revision/wiring.
#
# Syntax reference:
#   IO_LOC  "port_name" <pin_number>;
#   IO_PORT "port_name" IO_TYPE=LVCMOS33 [PULL_MODE=UP|DOWN|NONE];
#
# Example (uncomment after verifying pins):
# IO_LOC  "clk" 52;
# IO_PORT "clk" IO_TYPE=LVCMOS33;
#
# IO_LOC  "rst" 51;
# IO_PORT "rst" IO_TYPE=LVCMOS33 PULL_MODE=UP;
#
# IO_LOC  "k1"  40;
# IO_PORT "k1"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
#
# IO_LOC  "k2"  41;
# IO_PORT "k2"  IO_TYPE=LVCMOS33 PULL_MODE=UP;
#
# mode[1:0]
# IO_LOC  "mode[0]" 42;
# IO_PORT "mode[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
# IO_LOC  "mode[1]" 43;
# IO_PORT "mode[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
#
# dcycle[3:0]
# IO_LOC  "dcycle[0]" 44;
# IO_PORT "dcycle[0]" IO_TYPE=LVCMOS33;
# IO_LOC  "dcycle[1]" 45;
# IO_PORT "dcycle[1]" IO_TYPE=LVCMOS33;
# IO_LOC  "dcycle[2]" 46;
# IO_PORT "dcycle[2]" IO_TYPE=LVCMOS33;
# IO_LOC  "dcycle[3]" 47;
# IO_PORT "dcycle[3]" IO_TYPE=LVCMOS33;
#
# IO_LOC  "syncout" 48;
# IO_PORT "syncout" IO_TYPE=LVCMOS33;
#
# segment[7:0]
# IO_LOC  "segment[0]" 53;
# IO_PORT "segment[0]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[1]" 54;
# IO_PORT "segment[1]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[2]" 55;
# IO_PORT "segment[2]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[3]" 56;
# IO_PORT "segment[3]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[4]" 57;
# IO_PORT "segment[4]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[5]" 58;
# IO_PORT "segment[5]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[6]" 59;
# IO_PORT "segment[6]" IO_TYPE=LVCMOS33;
# IO_LOC  "segment[7]" 60;
# IO_PORT "segment[7]" IO_TYPE=LVCMOS33;
